---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title="¡Gracias! | Condominio Apolo"
      description="Gracias por contactarnos. Un asesor se comunicará contigo a la brevedad."
      canonical="https://condominio-apolo.inmobiliariahuertas.com/gracias"
      openGraph={{
        basic: {
          title: "¡Gracias! | Condominio Apolo",
          type: "website",
          image:
            "https://condominio-apolo.inmobiliariahuertas.com/images/hero-banner.webp",
          url: "https://condominio-apolo.inmobiliariahuertas.com/gracias",
        },
        optional: {
          description:
            "Gracias por contactarnos. Un asesor se comunicará contigo a la brevedad.",
          siteName: "Condominio Apolo - Huertas Inmobiliaria",
          locale: "es_ES",
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: "@HuertasInmobiliaria",
        title: "¡Gracias! | Condominio Apolo",
        description:
          "Gracias por contactarnos. Un asesor se comunicará contigo a la brevedad.",
        image:
          "https://condominio-apolo.inmobiliariahuertas.com/images/hero-banner.webp",
      }}
    />

    <script>
      {!function (f, b, e, v, n, t, s) {
        if (f.fbq) return; n = f.fbq = function () { n.callMethod ?
          n.callMethod.apply(n, arguments) : n.queue.push(arguments) };
        if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0';
        n.queue = []; t = b.createElement(e); t.async = !0;
        t.src = v; s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s)
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1467654321211140');
      fbq('track', 'PageView');}
    </script>
  </head>
  <body>

    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=1467654321211140&ev=PageView&noscript=1" /></noscript>

    <header>
      <Navbar />
    </header>

    <main>
      <section
        class="bg-cover bg-center bg-no-repeat flex flex-col min-h-[60vh]"
        style="background-image: url('/images/fondo-global.webp');"
        aria-label="Página de agradecimiento"
      >
        <div class="container mx-auto px-6 md:px-12 flex-1 flex items-center justify-center">
          <div class="bg-white/90 backdrop-blur rounded-3xl p-8 md:p-12 text-center max-w-2xl w-full shadow-2xl">
            <div class="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h1 class="text-2xl md:text-4xl font-bold text-secondary mb-3">¡Gracias por escribirnos!</h1>
            <p class="text-gray-700 text-base md:text-lg mb-8">
              Hemos recibido tus datos correctamente. Un asesor de Huertas Inmobiliaria se pondrá en contacto contigo a la brevedad.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/" class="bg-gradient-to-t from-[#e98f0d] to-primary text-white font-bold py-3 px-8 rounded-full text-base md:text-lg transition-opacity hover:opacity-90">
                Volver al inicio
              </a>
              <a href="/#contacto" class="bg-white text-primary font-bold py-3 px-8 rounded-full border border-primary text-base md:text-lg transition-colors hover:bg-primary/10">
                Enviar otro mensaje
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
  </html>
